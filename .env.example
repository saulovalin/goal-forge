# Supavisor Transaction pooler (porta 6543) — runtime da aplicação
DATABASE_URL="postgresql://USER:PASSWORD@TRANSACTION_POOLER_HOST:6543/postgres?pgbouncer=true"

# Supavisor Session pooler (porta 5432) — Prisma CLI e migrations
DIRECT_URL="postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres"
